{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: FastAPI",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "main:app",
        "--reload",
        "--port",
        "8080"
      ],
      "env": {
        "FRONTEND_URL":"http://localhost:4200",
        "ENVIRONMENT":"development",
        "LOG_LEVEL":"INFO",
        "PROJECT_ID":"nachov-argolis",
        "GENMEDIA_BUCKET":"nachov-argolis-creative-studio-arena-genmedia",
        "SIGNING_SA_EMAIL":"sa-genmedia-creative-studio@nachov-argolis.iam.gserviceaccount.com",
        "GOOGLE_TOKEN_AUDIENCE":"464814743320-capeh5tgc0eb43pk1dr7u12rg18p1g3k.apps.googleusercontent.com",
        "IDENTITY_PLATFORM_ALLOWED_ORGS":"",
      },
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/backend/.env",
      "jinja": true
    },
    {
      "name": "Mesop: Run main.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/venv/bin/mesop",
      // Load environment variables from a .env file in the project root.
      "envFile": "${workspaceFolder}/.env",
      "args": [
        "main.py"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
